{
  "name": "clipio",
  "displayName": "Clipio: Snippets Manager",
  "description": "A powerful browser extension for managing and inserting snippets with lightning speed and increase your productivity.",
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-qa.mjs",
    "dev:wxt": "wxt",
    "dev:qa-server": "node scripts/dev-qa-server.mjs",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"./**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "format:check": "prettier --check \"./**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@platejs/basic-nodes": "^52.0.11",
    "@platejs/floating": "^52.0.11",
    "@platejs/slate": "^52.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@sentry/browser": "^10.64.0",
    "@sentry/core": "^10.64.0",
    "@sentry/react": "^10.64.0",
    "@wxt-dev/i18n": "^0.2.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "platejs": "^52.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "unplugin-fonts": "^1.4.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
