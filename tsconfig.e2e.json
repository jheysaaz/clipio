{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // WXT 0.21 turns this on in .wxt/tsconfig.json. It flags ~250 existing
    // index accesses as possibly-undefined, which is a real improvement but is
    // a separate piece of work from a dependency bump: fixing them properly
    // means auditing each access rather than asserting a non-null.
    //
    // Opting out here keeps this commit to the upgrade itself. Turn it on as its
    // own change, with the source edits that follow.
    "noUncheckedIndexedAccess": false,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["e2e/**/*.ts", "playwright.config.ts"]
}
